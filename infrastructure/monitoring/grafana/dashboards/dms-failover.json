{
  "title": "Chuyển đổi và phục hồi",
  "uid": "dms-failover",
  "tags": ["dms", "failover"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "editable": true,
  "panels": [
    {
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Đọc bảng này thế nào:** mỗi dải là một node theo thời gian. Màu **xanh dương** = đang giữ vai trò chính, **xanh lá** = đang sống (dự phòng), **đỏ** = không trả lời. Khi một máy chết, dải của node đó chuyển đỏ và vai trò chính (xanh dương) nhảy sang node khác: khoảng cách giữa hai điểm đó là thời gian chuyển đổi."
      }
    },
    {
      "type": "state-timeline",
      "title": "CSDL (Patroni): node nào là máy chính",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 3 },
      "targets": [
        { "expr": "max by (instance) ((patroni_primary * 2 + on(instance) group_left up{job=\"patroni\"}) or on(instance) up{job=\"patroni\"})", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Không trả lời", "color": "red" }, "1": { "text": "Bản sao", "color": "green" }, "3": { "text": "Máy chính", "color": "blue" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }, { "color": "blue", "value": 3 }] }
        }
      },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } }
    },
    {
      "type": "state-timeline",
      "title": "etcd: nút nào là leader (bầu máy chính cho Patroni)",
      "datasource": "Prometheus",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 11 },
      "targets": [
        { "expr": "max by (instance) ((etcd_server_is_leader * 2 + on(instance) group_left up{job=\"etcd\"}) or on(instance) up{job=\"etcd\"})", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Không trả lời", "color": "red" }, "1": { "text": "Thành viên", "color": "green" }, "3": { "text": "Leader", "color": "blue" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }, { "color": "blue", "value": 3 }] }
        }
      },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } }
    },
    {
      "type": "state-timeline",
      "title": "Bản dịch vụ: Search Gateway, content-worker, node phòng ban",
      "datasource": "Prometheus",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 17 },
      "targets": [
        { "expr": "up{job=~\"dms-search-engine-service|dms-content-worker|dms-departments\"}", "legendFormat": "{{job}} {{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "Không trả lời", "color": "red" }, "1": { "text": "Đang sống", "color": "green" } } }],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } }
    },
    {
      "type": "timeseries",
      "title": "Độ trễ ghi đĩa etcd (p99): quyết định tốc độ chuyển máy chính",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 26 },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum by (le, instance) (rate(etcd_disk_wal_fsync_duration_seconds_bucket[1m])))", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Độ trễ hàng đợi Kafka (lag): dữ liệu đồng bộ còn tồn",
      "datasource": "Prometheus",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 26 },
      "targets": [
        { "expr": "sum by (consumergroup) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}}", "refId": "A" }
      ]
    }
  ]
}
