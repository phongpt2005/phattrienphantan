{
  "name": "central-down",
  "description": "CSDL trung tâm sập: tìm kiếm vẫn 200 qua node và bản chụp; sau khi phục hồi tìm kiếm vẫn đạt",
  "steps": [
    {"do": "login", "as": "hr", "dept": "hr", "user": "hr_manager", "password_env": "DEMO_MANAGER_PASSWORD"},
    {"do": "search", "as": "hr", "q": "hop dong", "expect_status": 200},
    {"do": "stop", "containers": ["postgres-central-primary", "postgres-central-replica"]},
    {"do": "wait", "seconds": 6},
    {"do": "search", "as": "hr", "q": "hop dong", "expect_status": 200},
    {"do": "start", "containers": ["postgres-central-primary", "postgres-central-replica"]},
    {"do": "wait_healthy", "containers": ["postgres-central-primary", "postgres-central-replica"], "timeout": 120},
    {"do": "search", "as": "hr", "q": "hop dong", "expect_status": 200, "expect_partial": false}
  ]
}
