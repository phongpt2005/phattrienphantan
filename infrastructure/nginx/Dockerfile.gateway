# Cụm 3 máy (Swarm): gateway nginx đóng gói sẵn cấu hình và giao diện (frontend/dist), vì Swarm chạy container trên
# máy khác nên không gắn thư mục từ máy build được. Build sau khi đã `npm run build` trong frontend.
FROM nginx:alpine
COPY infrastructure/nginx/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/nginx/conf.d/ /etc/nginx/conf.d/
COPY frontend/dist/ /usr/share/nginx/html/
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
