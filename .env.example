# ============================================================
# MẪU CẤU HÌNH DMS
# Không dùng trực tiếp file này. Chạy:  bash scripts/setup.sh
# Script sẽ tạo .env từ file này và thay mỗi giá trị CHANGE_ME
# bằng một chuỗi ngẫu nhiên. File .env chứa bí mật: không commit.
# ============================================================

# --- Cấu hình chung ---
COMPOSE_PROJECT_NAME=distributed-dms
TIMEZONE=Asia/Ho_Chi_Minh
SEED_DEMO_USERS=true

# --- Cổng ra ngoài máy: gateway (8000) và cổng HR (3001) ---
NGINX_HTTP_PORT=8000
SVC_HR_PORT=3001

# --- Cổng nội bộ (không publish ra ngoài máy) ---
NGINX_HTTPS_PORT=8443
SVC_ACC_PORT=3002
SVC_SEARCH_PORT=3003
POSTGRES_HR_PORT=5433
POSTGRES_ACC_PORT=5434
POSTGRES_CENTRAL_PORT=5435
REDIS_PORT=6379
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093
DEBEZIUM_PORT=8083
MINIO_HR_API_PORT=9010
MINIO_HR_CONSOLE_PORT=9011
MINIO_ACC_API_PORT=9002
MINIO_ACC_CONSOLE_PORT=9003

# --- Tên đăng nhập quản trị hạ tầng (không phải bí mật) ---
POSTGRES_HR_USER=hr_admin
POSTGRES_HR_DB=dms_hr
POSTGRES_ACC_USER=acc_admin
POSTGRES_ACC_DB=dms_accounting
POSTGRES_CENTRAL_USER=central_admin
POSTGRES_CENTRAL_DB=dms_central
POSTGRES_REPLICATION_USER=repl_user
MINIO_HR_ROOT_USER=hr_minio_admin
MINIO_ACC_ROOT_USER=acc_minio_admin

# --- Bí mật: setup.sh sinh ngẫu nhiên thay cho CHANGE_ME ---
POSTGRES_HR_PASSWORD=CHANGE_ME
POSTGRES_ACC_PASSWORD=CHANGE_ME
POSTGRES_CENTRAL_PASSWORD=CHANGE_ME
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME
MINIO_HR_ROOT_PASSWORD=CHANGE_ME
MINIO_ACC_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
BACKUP_ENCRYPTION_KEY=CHANGE_ME
DEPT_REPL_PASSWORD_SALES=CHANGE_ME

# --- Mật khẩu demo: cố định, vì nút đăng nhập nhanh trong giao diện dùng đúng các giá trị này.
#     Chỉ dùng trên máy cá nhân. ---
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_MANAGER_PASSWORD=Admin@123
DEMO_STAFF_PASSWORD=Staff@123
